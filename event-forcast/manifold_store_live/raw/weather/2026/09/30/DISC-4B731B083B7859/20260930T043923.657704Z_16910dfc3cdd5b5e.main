<div class="bl-body" id="content">
<FORM action="olstore.prodlist" method=post>
<h1> NCEI Data and Products</h1>
<ol>
<li>
<h3> Select category of products </h3>
<input id="CATEGORYA" checked="" value="A" NAME="CATEGORY" TYPE="RADIO"> <label for="CATEGORYA"> *All</label>
<BR>
<input id="CATEGORYC" value="C" name="CATEGORY" type="RADIO"></input>
               <label for="CATEGORYC">Climate</label>
<select name="SUBCATC" onChange="setCategory(this.form,1;">
<option value=01>*All</option>
<option value=48>-Bibliography</option>
<option value=43>-Climate Change/Global Warming</option>
<option value=31>-Climatology/Normals</option>
<option value=30>-Documentation</option>
<option value=38>-Graphics and Maps</option>
<option value=40>-Reports and Papers</option>
<option value=25>Data, Cloud</option>
<option value=37>Data, Gridded/Model</option>
<option value=29>Data, Ice</option>
<option value=21>Data, Inventories</option>
<option value=28>Data, Marine</option>
<option value=27>Data, Moisture</option>
<option value=02>Data, Precipitation</option>
<option value=24>Data, Pressure</option>
<option value=11>Data, Snow</option>
<option value=22>Data, Solar</option>
<option value=06>Data, Temperature</option>
<option value=23>Data, Wind</option>
<option value=42>Events, El Nino/La Nina</option>
<option value=41>Events, Extreme Climate</option>
<option value=47>Events, Hurricanes/Cyclones</option>
<option value=34>Events, Tornadoes</option>
<option value=16>Observations, Surface Weather</option>
<option value=17>Observations, Upper Air</option>
</select>
<BR>
<input id="CATEGORYG" value="G" name="CATEGORY" type="RADIO"></input>
               <label for="CATEGORYG">Geophysical</label>
<select name="SUBCATG" onChange="setCategory(this.form,2;">
<option value=00>*All</option>
<option value=34>Aeromagnetic Data</option>
<option value=01>Aurora</option>
<option value=02>Bathymetry/Topography</option>
<option value=03>Climatology</option>
<option value=04>Coastlines</option>
<option value=05>Computer Imagery</option>
<option value=06>Coral</option>
<option value=07>Cosmic Rays</option>
<option value=08>Earthquake</option>
<option value=09>Environmental Data</option>
<option value=14>GIS Data</option>
<option value=10>Gazetteer</option>
<option value=11>Geochemistry</option>
<option value=36>Geographic Boundaries</option>
<option value=12>Geology</option>
<option value=13>Geomagnetism</option>
<option value=15>Gravity Data</option>
<option value=16>Great Lakes</option>
<option value=38>Habitat Characterization</option>
<option value=17>Ice Cores</option>
<option value=18>Ionosphere</option>
<option value=19>Magnetic Data</option>
<option value=20>Marine Geology</option>
<option value=21>Marine Geophysics</option>
<option value=22>Marine Minerals</option>
<option value=23>Marine Sediment and Rock</option>
<option value=33>Multibeam Bathymetry</option>
<option value=24>Natural Hazards</option>
<option value=25>Ocean Drilling</option>
<option value=26>Paleoceanography</option>
<option value=27>Paleoclimatology</option>
<option value=28>Pollen</option>
<option value=29>Satellite Data</option>
<option value=35>Seismic Reflection Data</option>
<option value=30>Solar Data</option>
<option value=37>Tree Rings</option>
<option value=31>Tsunamis</option>
<option value=32>Volcanology</option>
</select>
<BR>
<input id="CATEGORYO" value="O" name="CATEGORY" type="RADIO"></input>
               <label for="CATEGORYO">Oceanographic</label>
<select name="SUBCATO" onChange="setCategory(this.form,3;">
<option value=01>*All</option>
</select>
<BR>
<input id="CATEGORYR" value="R" name="CATEGORY" type="RADIO"></input>
               <label for="CATEGORYR">Radar</label>
<select name="SUBCATR" onChange="setCategory(this.form,4;">
<option value=01>*All</option>
<option value=03>-Documentation</option>
<option value=02>-Images</option>
<option value=04>-Reports and Papers</option>
<option value=05>Data</option>
<option value=06>Data, Inventories</option>
<option value=07>Events</option>
</select>
<BR>
<input id="CATEGORYS" value="S" name="CATEGORY" type="RADIO"></input>
               <label for="CATEGORYS">Satellite</label>
<select name="SUBCATS" onChange="setCategory(this.form,5;">
<option value=01>*All</option>
<option value=09>*Defense Meteorological (DMSP)</option>
<option value=18>*Geodetic (GEOSAT)</option>
<option value=10>*Geostationary (GOES)</option>
<option value=11>*Polar Orbiting (POES)</option>
<option value=12>*Total Ozone Mapping (TOMS)</option>
<option value=13>*Upper Atmosphere (UARS)</option>
<option value=14>Aerosols</option>
<option value=19>CLASS datasets - Custom</option>
<option value=15>Cloud Climatology (ISCCP)</option>
<option value=06>Data, Inventories</option>
<option value=03>Documentation</option>
<option value=07>Events</option>
<option value=16>Global Vegetation Index (GVI)</option>
<option value=02>Images and Charts</option>
<option value=08>Reports and Papers</option>
<option value=17>Temperature, Sea-Surface</option>
</select>
<BR>
<input id="CATEGORYU" value="U" name="CATEGORY" type="RADIO"></input>
               <label for="CATEGORYU">User Description</label>
<select name="SUBCATU" onChange="setCategory(this.form,6;">
<option value=09>Agriculture</option>
<option value=02>Consultant</option>
<option value=05>Consulting Meteorologist</option>
<option value=06>Contractor</option>
<option value=14>Engineer</option>
<option value=03>Insurance</option>
<option value=01>Lawyer/Legal</option>
<option value=11>News Media</option>
<option value=04>Research</option>
<option value=12>Schools/Education</option>
<option value=13>Transportation</option>
<option value=08>Utilities</option>
</select>
<BR>
<BR>
</li>
<input id="GROUPINA">
<li>
<h3><label for="GROUPINA">Group</LABEL></h3>
<SELECT NAME="GROUPIN" SIZE=1 ID="GROUPINA">
<option selected="selected" VALUE=ALL>*All Products</option>
<option VALUE=CDV>CD-ROM/DVD</option>
<option VALUE=ONL>Online</option>
<option VALUE=POS>Posters</option>
<option VALUE=PUB>Publication</option>
<option VALUE=SLI>Slides</option>
<option VALUE=SUB>Subscription</option>
</select></li>
<CENTER><INPUT type=submit value="Continue"><BR>
</ol>
</form>
<P><P>
</div>
